<!DOCTYPE html>
<html lang="zh-TW">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>股票代號神搜器</title>

  <style>
    :root {
      --primary-color: #00ffcc;
      --bg-color: #0a0a0a;
      --card-bg: #1e1e1e;
      --text-gray: #aaaaaa;
    }

    html, body {
      height: 100dvh;
      margin: 0;
      padding: 0;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
      background: var(--bg-color);
      color: white;
      display: flex;
      flex-direction: column;
      overflow: hidden; /* 鎖死畫面，靠內部滾動 */
    }

    header {
      padding: 15px;
      text-align: center;
      background: var(--card-bg);
      box-shadow: 0 4px 15px rgba(0,0,0,0.5);
      z-index: 10;
    }
    h2 { margin: 0; font-size: 26px; letter-spacing: 2px; color: var(--primary-color); }

    /* --- 分頁切換器 (Tabs) --- */
    .tabs {
      display: flex;
      background: #222;
    }
    .tab-btn {
      flex: 1;
      padding: 15px 0;
      font-size: 18px;
      font-weight: bold;
      color: var(--text-gray);
      background: transparent;
      border: none;
      border-bottom: 4px solid transparent;
      transition: 0.3s;
    }
    .tab-btn.active {
      color: var(--primary-color);
      border-bottom: 4px solid var(--primary-color);
      background: rgba(0, 255, 204, 0.1);
    }

    /* --- 主要內容區塊 --- */
    .view-section {
      display: none;
      flex-direction: column;
      flex: 1;
      overflow-y: auto;
    }
    .view-section.active {
      display: flex;
    }

    /* 📷 相機模式 */
    #cameraWrapper {
      position: relative;
      flex: 1;
      background: black;
    }
    video { width: 100%; height: 100%; object-fit: cover; position: absolute; }
    
    #scanBox {
      position: absolute;
      top: 40%; left: 50%;
      transform: translate(-50%, -50%);
      width: 75%; height: 25%;
      border: 3px solid var(--primary-color);
      border-radius: 12px;
      box-shadow: 0 0 0 5000px rgba(0, 0, 0, 0.7);
      pointer-events: none;
    }
    #scanBox::after {
      content: "請將公司名或代號對準框內";
      position: absolute; bottom: -35px; left: 0; right: 0;
      text-align: center; font-size: 16px; font-weight: bold;
      color: var(--primary-color); text-shadow: 1px 1px 2px black;
    }

    /* ⌨️ 手動輸入模式 */
    #manualWrapper {
      padding: 30px 20px;
      align-items: center;
    }
    .input-title { font-size: 22px; margin-bottom: 15px; color: var(--text-gray); }
    #searchInput {
      width: 100%; max-width: 400px;
      padding: 20px; font-size: 24px;
      border-radius: 15px; border: 2px solid #444;
      background: #111; color: white;
      text-align: center; box-sizing: border-box;
      margin-bottom: 20px;
    }
    #searchInput:focus { border-color: var(--primary-color); outline: none; }

    /* --- 共用結果卡片與按鈕 --- */
    .control-panel {
      background: var(--card-bg);
      padding: 20px;
      border-radius: 20px 20px 0 0;
      text-align: center;
      box-shadow: 0 -5px 20px rgba(0,0,0,0.5);
      flex-shrink: 0;
    }

    #resultArea {
      font-size: 24px; font-weight: bold; color: #fff;
      margin-bottom: 15px; min-height: 70px;
      display: flex; align-items: center; justify-content: center;
      white-space: pre-line; background: #111;
      border-radius: 12px; padding: 15px;
      border: 1px solid #333;
    }

    .main-btn {
      width: 100%; max-width: 400px;
      padding: 18px; font-size: 24px; font-weight: 900;
      border-radius: 15px; border: none;
      background: linear-gradient(135deg, #00ffcc 0%, #00c896 100%);
      color: #053329; box-shadow: 0 4px 15px rgba(0, 255, 204, 0.3);
      touch-action: manipulation; transition: 0.1s;
    }
    .main-btn:active { transform: scale(0.96); background: #00a87a; }
    
    /* 載入畫面 */
    #loadingOverlay {
      position: fixed; top: 0; left: 0; right: 0; bottom: 0;
      background: rgba(0,0,0,0.9); z-index: 100;
      display: flex; flex-direction: column; justify-content: center; align-items: center;
    }
    .spinner { border: 5px solid #333; border-top: 5px solid var(--primary-color); border-radius: 50%; width: 50px; height: 50px; animation: spin 1s linear infinite; margin-bottom: 20px;}
    @keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
  </style>
</head>

<body>

<header>
  <h2>歡迎查詢</h2>
</header>

<!-- 分頁按鈕 -->
<div class="tabs">
  <button class="tab-btn active" id="tabCamera">📷 相機掃描</button>
  <button class="tab-btn" id="tabManual">⌨️ 手動輸入</button>
</div>

<!-- 視圖 A：相機 -->
<div id="viewCamera" class="view-section active">
  <div id="cameraWrapper">
    <video id="camera" autoplay playsinline></video>
    <div id="scanBox"></div>
  </div>
  <div class="control-panel">
    <div id="resultCamera" style="display:none;"></div> <!-- 隱藏，統一日用 resultArea -->
    <button id="btnScan" class="main-btn">🔍 辨識框內文字</button>
  </div>
</div>

<!-- 視圖 B：手動 -->
<div id="viewManual" class="view-section">
  <div id="manualWrapper">
    <div class="input-title">輸入公司名稱、簡稱或代號</div>
    <input type="text" id="searchInput" placeholder="例如：台積電、2330">
    <button id="btnSearch" class="main-btn">馬上查詢</button>
  </div>
</div>

<!-- 全域結果顯示 (浮動在最底下) -->
<div style="padding: 15px; background: var(--bg-color); z-index:20;">
  <div id="resultArea">資料庫載入中，請稍候...</div>
</div>

<!-- 初始載入遮罩 -->
<div id="loadingOverlay">
  <div class="spinner"></div>
  <h3 style="color:var(--primary-color);">正在下載最新股票資料...</h3>
</div>

<script>
// 🔥 API KEY (記得正式上線要限制網域)
const API_KEY = "AIzaSyDBkTyVVS_wfaIqaGrybx4WfSsyTGgkdn0";

// 📦 資料庫變數
let stockDatabase = [];

// 🚀 1. 自動從 GitHub 讀取 CSV
async function loadCSV() {
  try {
    // 這裡使用相對路徑，只要 stock.csv 跟這個 HTML 放在 GitHub 同一個資料夾就能讀到！
    const response = await fetch('./stock.csv'); 
    if (!response.ok) throw new Error("讀取失敗");
    
    const csvText = await response.text();
    const lines = csvText.trim().split(/\r?\n/);
    
    // 跳過標題列 (第一行)
    for (let i = 1; i < lines.length; i++) {
      const cols = lines[i].split(",");
      if (cols.length >= 3) {
        // n:公司名稱, s:公司簡稱, c:公司代號
        stockDatabase.push({ n: cols[0].trim(), s: cols[1].trim(), c: cols[2].trim() });
      }
    }
    document.getElementById("loadingOverlay").style.display = "none";
    document.getElementById("resultArea").innerText = `✅ 準備就緒！已載入 ${stockDatabase.length} 檔股票`;
  } catch (error) {
    document.getElementById("resultArea").innerText = "❌ 資料庫載入失敗\n請確認 stock.csv 是否存在";
    document.getElementById("loadingOverlay").style.display = "none";
  }
}

// 啟動讀取
loadCSV();

// 🎯 2. 進階版模糊搜尋邏輯 (解決找不到台積電的問題)
function searchStock(text) {
  if (!text) return "⚠️ 請輸入文字";
  const cleanText = text.replace(/\s+/g, ""); // 去除空白

  // A. 先找 4 位數純數字
  const codeMatch = cleanText.match(/\b\d{4}\b/g);
  if (codeMatch) {
    const validCode = codeMatch.find(n => n !== "2026" && n !== "2025");
    if (validCode) {
      const found = stockDatabase.find(item => item.c === validCode);
      if (found) return `🟢 查詢成功\n代號：${found.c} (${found.n})`; // 顯示全名更清楚
    }
  }

  // B. 強力模糊比對 (解決「台積電」對不上「台積」的問題)
  // 條件：只要輸入的字包含在簡稱/全名中，或簡稱/全名包含在輸入的字中，就算中！
  const foundStock = stockDatabase.find(item => {
    return item.s.includes(cleanText) || cleanText.includes(item.s) ||
           item.n.includes(cleanText) || cleanText.includes(item.n);
  });

  if (foundStock) {
    return `🟢 查詢成功\n代號：${foundStock.c} (${foundStock.n})`;
  }

  return "⚠️ 找不到，請換個關鍵字或再掃一次";
}

// 📺 3. 視圖切換與相機控制
const tabCamera = document.getElementById("tabCamera");
const tabManual = document.getElementById("tabManual");
const viewCamera = document.getElementById("viewCamera");
const viewManual = document.getElementById("viewManual");
const video = document.getElementById("camera");
let streamRef = null;

function startCamera() {
  navigator.mediaDevices.getUserMedia({
    video: { facingMode: "environment", width: { ideal: 1280 } }
  }).then(stream => {
    streamRef = stream;
    video.srcObject = stream;
  }).catch(err => {
    document.getElementById("resultArea").innerText = "相機權限未開啟或無法使用";
  });
}

function stopCamera() {
  if (streamRef) {
    streamRef.getTracks().forEach(track => track.stop());
    streamRef = null;
    video.srcObject = null;
  }
}

// 預設開啟相機
startCamera();

tabCamera.onclick = () => {
  tabCamera.classList.add("active");
  tabManual.classList.remove("active");
  viewCamera.classList.add("active");
  viewManual.classList.remove("active");
  startCamera();
};

tabManual.onclick = () => {
  tabManual.classList.add("active");
  tabCamera.classList.remove("active");
  viewManual.classList.add("active");
  viewCamera.classList.remove("active");
  stopCamera(); // 切到手動時，關閉相機省電
};

// 🔘 4. 按鈕動作
const resultArea = document.getElementById("resultArea");

// 手動搜尋
document.getElementById("btnSearch").onclick = () => {
  const val = document.getElementById("searchInput").value;
  resultArea.innerText = searchStock(val);
  
  // 收起手機鍵盤
  document.getElementById("searchInput").blur();
};

// 相機搜尋
document.getElementById("btnScan").onclick = async () => {
  const btn = document.getElementById("btnScan");
  resultArea.innerText = "讀取影像中...\n請稍候";
  btn.disabled = true;

  const canvas = document.createElement("canvas");
  const w = video.videoWidth;
  const h = video.videoHeight;
  canvas.width = w; canvas.height = h;
  const ctx = canvas.getContext("2d");

  // 裁切畫面
  const clipW = w * 0.75;
  const clipH = h * 0.25;
  const clipX = (w - clipW) / 2;
  const clipY = (h - clipH) / 2;
  ctx.drawImage(video, clipX, clipY, clipW, clipH, 0, 0, canvas.width, canvas.height);

  try {
    const base64 = canvas.toDataURL("image/jpeg", 0.8).split(",")[1];
    const response = await fetch(
      `https://vision.googleapis.com/v1/images:annotate?key=${API_KEY}`,
      { method: "POST", body: JSON.stringify({ requests: [{ image: { content: base64 }, features: [{ type: "TEXT_DETECTION" }] }] }) }
    );
    const data = await response.json();
    const text = data.responses?.[0]?.fullTextAnnotation?.text || "";
    resultArea.innerText = searchStock(text);
  } catch (e) {
    resultArea.innerText = "❌ 網路連線失敗，請檢查網路";
  } finally {
    btn.disabled = false;
  }
};
</script>

</body>
</html>
